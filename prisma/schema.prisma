// Schema da Fatia 0/1 (fundação + MVP de metas) + Fatia 2 (Gamification Engine).
// empresa_id + loja_id em toda tabela desde o início — ver decisão em
// 05-Decisoes-e-Tradeoffs.md (multi-loja lógico, não multi-tenant físico).
// Régua de XP/moeda e fórmula de Score Geral vêm de
// /Users/Franklin/Downloads/FONTE_DE_VERDADE_VENDEDOR_IA.md (fonte de verdade do produto).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id        String   @id @default(uuid())
  nome      String
  createdAt DateTime @default(now())

  lojas          Loja[]
  aiBudgetConfig AIBudgetConfig?
  playbooks      Playbook[]

  aiConfiguration CompanyAIConfiguration?
  aiCredenciais   AIProviderCredential[]
  aiHealth        AIProviderHealth[]

  @@map("empresa")
}

model Loja {
  id        String   @id @default(uuid())
  empresaId String
  nome      String
  codigoErp String
  createdAt DateTime @default(now())

  empresa    Empresa    @relation(fields: [empresaId], references: [id])
  vendedores Vendedor[]

  @@index([empresaId])
  @@map("loja")
}

enum Papel {
  VENDEDOR
  GERENTE
  ADMIN
}

// Ciclo de vida da conta (Fatia 7.5A, seção 12) — substitui o antigo campo
// `ativo: Boolean`. PENDING_ACTIVATION: pré-autorizado pelo Admin, ainda sem
// senha própria (senhaHash null) — não consegue logar. ACTIVE: uso normal.
// BLOCKED: acesso temporariamente impedido (reversível via desbloqueio).
// OFFBOARDED: vínculo profissional encerrado (reversível via reativação) —
// nunca hard delete, todo o histórico (vendas/XP/moedas/badges/missões/
// conversas) permanece intacto e ligado ao mesmo id.
enum StatusConta {
  PENDING_ACTIVATION
  ACTIVE
  BLOCKED
  OFFBOARDED
}

model Vendedor {
  id           String      @id @default(uuid())
  empresaId    String
  lojaId       String
  matriculaErp String
  nome         String
  // Nullable: uma conta PENDING_ACTIVATION (pré-autorizada pelo Admin, seção
  // 39) ainda não tem senha própria — só ganha uma no fluxo de ativação
  // (seção 10/11). Login e requireAuth já checam `status === 'ACTIVE'` antes
  // de qualquer comparação de senha, então nunca chegam a comparar contra null.
  senhaHash    String?
  papel        Papel       @default(VENDEDOR)
  status       StatusConta @default(ACTIVE)
  createdAt    DateTime    @default(now())

  // CPF (Fatia 7.5A, seção 5/6) — NUNCA armazenado em claro. cpfHash é um
  // HMAC determinístico (ver src/identidade/cpf.ts) usado só pra unicidade
  // dentro da empresa e pra localizar a conta durante a ativação;
  // cpfUltimosDigitos guarda só os 2 últimos dígitos, suficiente pra exibir
  // a máscara "***.***.***-XX" sem nunca reconstruir o valor completo.
  // Nullable: ADMIN/GERENTE cadastrados pelo fluxo antigo (POST /vendedores)
  // podem não ter CPF; e contas seedadas antes desta fatia também não têm.
  cpfHash           String?
  cpfUltimosDigitos String?

  loja Loja @relation(fields: [lojaId], references: [id])

  metas       Meta[]
  indicadores IndicadorRealizado[]

  xpTransacoes     XpTransacao[]
  moedaTransacoes  MoedaTransacao[]
  streak           StreakVendedor?
  badges           BadgeConcessao[]
  rankingSnapshots RankingSnapshot[]

  checkins            CoachCheckIn[]
  conversasCoach      CoachConversation[]
  memoriaProfissional ProfessionalMemory?
  usosIA              AIUsage[]
  conversasTreinador  TrainerConversation[]
  sessoesSimulacao    SimulationSession[]
  progressoAcademia   AcademyProgress[]
  missoes             MissionAssignment[]
  desafios            ChallengeAssignment[]

  tokensAtivacao      ActivationToken[]
  identidadesExternas ExternalIdentity[]
  auditoriasComoAtor  AuditEvent[]       @relation("AuditEventAtor")
  auditoriasComoAlvo  AuditEvent[]       @relation("AuditEventAlvo")

  @@unique([lojaId, matriculaErp])
  // NULL é distinto de NULL no Postgres — vendedores sem CPF (ADMIN/GERENTE
  // legado, contas seedadas antes desta fatia) nunca colidem entre si aqui.
  @@unique([empresaId, cpfHash])
  @@index([empresaId, lojaId])
  @@index([empresaId, status])
  @@map("vendedor")
}

enum TipoMeta {
  FATURAMENTO
  TICKET_MEDIO
  PA
}

enum PeriodoMeta {
  DIA
  SEMANA
  MES
}

model Meta {
  id         String      @id @default(uuid())
  empresaId  String
  lojaId     String
  vendedorId String
  tipo       TipoMeta
  periodo    PeriodoMeta
  referencia DateTime
  valorMeta  Decimal     @db.Decimal(12, 2)
  createdAt  DateTime    @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@unique([vendedorId, tipo, periodo, referencia])
  @@index([empresaId, lojaId])
  @@map("meta")
}

// Snapshot horário vindo do ERP — upsert por [vendedorId, dataHora], nunca duplica.
model IndicadorRealizado {
  id              String   @id @default(uuid())
  empresaId       String
  lojaId          String
  vendedorId      String
  dataHora        DateTime
  faturamento     Decimal  @db.Decimal(12, 2)
  ticketMedio     Decimal  @db.Decimal(12, 2)
  pa              Decimal  @db.Decimal(6, 2)
  numAtendimentos Int
  fonteJobId      String
  createdAt       DateTime @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@unique([vendedorId, dataHora])
  @@index([empresaId, lojaId, dataHora])
  @@map("indicador_realizado")
}

// =====================================================================
// FATIA 2 — GAMIFICATION ENGINE
// =====================================================================

enum TipoEventoGamificacao {
  CHECKIN_DIARIO
  TREINAMENTO_CONCLUIDO
  QUIZ_APROVADO
  META_DIARIA_100
  META_DIARIA_110
  META_DIARIA_120
  META_DIARIA_150
  MELHORA_PA
  MELHORA_TICKET
  STREAK_3
  STREAK_5
  STREAK_10
  MISSAO
  AJUSTE_MANUAL
  REVERSAO
}

// Régua de XP/moeda e pesos do Score Geral — versionados (nunca hardcoded
// espalhado no motor). Só uma versão fica ativa por empresa por vez.
model RegraGamificacaoVersao {
  id          String   @id @default(uuid())
  empresaId   String
  versao      Int
  ativo       Boolean  @default(false)
  regrasXp    Json // { CHECKIN_DIARIO: 5, TREINAMENTO_CONCLUIDO: 20, META_DIARIA_100: 100, ... }
  regrasMoeda Json // { TREINAMENTO_CONCLUIDO: 5, META_DIARIA_100: 50, ... }
  pesosScore  Json // { meta: 0.40, evolucao: 0.20, pa: 0.15, ticket: 0.15, consistencia: 0.10 }
  criadoEm    DateTime @default(now())
  criadoPor   String

  @@unique([empresaId, versao])
  @@index([empresaId, ativo])
  @@map("regra_gamificacao_versao")
}

// Ledger imutável de XP — nunca um contador mutável. XP não é gasto e não diminui
// em situações normais (só REVERSAO compensa um evento incorretamente concedido).
model XpTransacao {
  id             String                @id @default(uuid())
  empresaId      String
  lojaId         String
  vendedorId     String
  tipoEvento     TipoEventoGamificacao
  quantidade     Int
  referenciaTipo String?
  referenciaId   String?
  idempotencyKey String                @unique
  regraVersao    Int
  ocorridoEm     DateTime
  createdAt      DateTime              @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@index([empresaId, lojaId, vendedorId])
  @@map("xp_transacao")
}

// Ledger imutável de VendaCoins — saldo é sempre a soma das transações válidas.
model MoedaTransacao {
  id             String                @id @default(uuid())
  empresaId      String
  lojaId         String
  vendedorId     String
  tipoEvento     TipoEventoGamificacao
  valor          Int // positivo = crédito, negativo = estorno/débito
  referenciaTipo String?
  referenciaId   String?
  idempotencyKey String                @unique
  regraVersao    Int
  ocorridoEm     DateTime
  createdAt      DateTime              @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@index([empresaId, lojaId, vendedorId])
  @@map("moeda_transacao")
}

// Estado corrente do streak (derivado dos fechamentos de dia). A fonte de
// auditoria é StreakChecagem; este registro é uma projeção pra leitura rápida.
model StreakVendedor {
  id                String    @id @default(uuid())
  empresaId         String
  lojaId            String
  vendedorId        String    @unique
  tipo              String    @default("META_DIARIA")
  streakAtual       Int       @default(0)
  maiorStreak       Int       @default(0)
  ultimaDataContada DateTime?
  atualizadoEm      DateTime  @updatedAt

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@map("streak_vendedor")
}

// Barreira de idempotência: cada dia fechado só é avaliado uma vez por vendedor/tipo.
model StreakChecagem {
  id         String   @id @default(uuid())
  vendedorId String
  tipo       String
  data       DateTime // dia normalizado (00:00)
  atingiu    Boolean
  createdAt  DateTime @default(now())

  @@unique([vendedorId, tipo, data])
  @@map("streak_checagem")
}

model Badge {
  id        String   @id @default(uuid())
  codigo    String   @unique
  titulo    String
  descricao String
  categoria String
  versao    Int      @default(1)
  createdAt DateTime @default(now())

  concessoes BadgeConcessao[]

  @@map("badge")
}

model BadgeConcessao {
  id             String   @id @default(uuid())
  empresaId      String
  lojaId         String
  vendedorId     String
  badgeId        String
  idempotencyKey String   @unique
  concedidoEm    DateTime @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])
  badge    Badge    @relation(fields: [badgeId], references: [id])

  @@index([empresaId, lojaId, vendedorId])
  @@map("badge_concessao")
}

// Baseline pessoal (não de segmento/loja) usado pra normalizar PA/ticket/evolução
// no Score Geral e pra decidir "melhora validada". Nunca inventado: só calculado
// quando há amostra mínima de dias fechados.
model BaselinePessoal {
  id            String   @id @default(uuid())
  vendedorId    String
  metrica       String // "PA" | "TICKET_MEDIO" | "FATURAMENTO_DIA"
  valor         Decimal  @db.Decimal(12, 4)
  amostras      Int
  amostraMinima Int
  atualizadoEm  DateTime @updatedAt

  @@unique([vendedorId, metrica])
  @@map("baseline_pessoal")
}

enum EscopoRanking {
  LOJA
  REDE
}

enum TipoRanking {
  FATURAMENTO
  PERCENTUAL_META
  PA
  TICKET
  EVOLUCAO
  MOEDAS
  SCORE_GERAL
}

// Snapshot calculado — nunca query ao vivo pra ranking (caro com centenas de
// vendedores). provisorio=true quando algum componente do score não tinha
// amostra suficiente (nunca vira score artificialmente baixo).
model RankingSnapshot {
  id          String        @id @default(uuid())
  empresaId   String
  escopo      EscopoRanking
  lojaId      String?
  tipo        TipoRanking
  periodo     PeriodoMeta
  referencia  DateTime
  vendedorId  String
  posicao     Int
  valor       Decimal       @db.Decimal(14, 4)
  provisorio  Boolean       @default(false)
  regraVersao Int
  calculadoEm DateTime      @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@index([empresaId, escopo, lojaId, tipo, periodo, referencia])
  @@map("ranking_snapshot")
}

// =====================================================================
// FATIA 4 — COACH IA CONTEXTUAL E SEGURO
// =====================================================================
// Princípio inegociável: motor calcula, IA interpreta/explica/treina/motiva.
// Nenhuma tabela aqui é escrita pelo LLM diretamente — sempre pelo backend,
// depois de validar limites (rate limit, budget, tamanho de mensagem).

enum MoodCheckIn {
  VERY_GOOD
  GOOD
  NEUTRAL
  NOT_GOOD
}

// Um check-in representa o estado do vendedor NO DIA — idempotente por
// [vendedorId, dia]. Refazer o check-in no mesmo dia atualiza o registro do
// dia (não duplica); dias anteriores nunca são reescritos, preservando
// histórico auditável.
model CoachCheckIn {
  id         String      @id @default(uuid())
  empresaId  String
  lojaId     String
  vendedorId String
  mood       MoodCheckIn
  dia        DateTime // dia normalizado (00:00) — chave de idempotência
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@unique([vendedorId, dia])
  @@map("coach_checkin")
}

enum StatusConversaCoach {
  ABERTA
  ENCERRADA
}

// Invariante "no máximo 1 conversa ABERTA por vendedor" é garantida por um
// índice único parcial (não expressável em @@unique) — ver migração
// 20260829210614_fatia4_uma_conversa_aberta_por_vendedor. Sem isso, chamadas
// concorrentes a getOrCreateConversaAtual/criarNovaConversa podiam criar
// conversas ABERTA duplicadas, cada uma com seu próprio lock de geração,
// permitindo furar rate limit/budget via requisições paralelas em conversas
// diferentes (achado de security review).
model CoachConversation {
  id                 String              @id @default(uuid())
  empresaId          String
  lojaId             String
  vendedorId         String
  status             StatusConversaCoach @default(ABERTA)
  // Lock simples de sequenciamento: só 1 resposta sendo gerada por vez nesta
  // conversa — evita respostas fora de ordem quando o vendedor manda 2
  // mensagens rápido (seção 20 da fonte de verdade).
  geracaoEmAndamento Boolean             @default(false)
  startedAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  closedAt           DateTime?

  vendedor  Vendedor       @relation(fields: [vendedorId], references: [id])
  mensagens CoachMessage[]

  @@index([empresaId, lojaId, vendedorId])
  @@map("coach_conversation")
}

enum RoleMensagemCoach {
  USER
  ASSISTANT
}

model CoachMessage {
  id               String            @id @default(uuid())
  conversationId   String
  role             RoleMensagemCoach
  content          String            @db.Text
  // Idempotência do lado do cliente — só preenchido em mensagens USER. NULL
  // nunca colide com NULL no unique index (comportamento padrão do Postgres),
  // então mensagens ASSISTANT (sempre NULL aqui) nunca conflitam entre si.
  clientMessageId  String?
  provider         String?
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUSD Decimal?          @db.Decimal(10, 6)
  latencyMs        Int?
  createdAt        DateTime          @default(now())

  conversation CoachConversation @relation(fields: [conversationId], references: [id])

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("coach_message")
}

// Memória profissional mínima — estritamente sobre desempenho/desenvolvimento
// de vendas, nunca sobre vida pessoal/emocional (seção 13/29 da fonte de
// verdade). Derivada deterministicamente pelo motor (baseline vs. realizado),
// nunca escrita livremente pelo LLM.
model ProfessionalMemory {
  id               String   @id @default(uuid())
  empresaId        String
  vendedorId       String   @unique
  strengths        Json     @default("[]")
  developmentAreas Json     @default("[]")
  currentFocus     String?
  summary          String?  @db.Text
  updatedAt        DateTime @updatedAt

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@map("coach_professional_memory")
}

enum StatusUsoIA {
  SUCESSO
  ERRO
  TIMEOUT
  BLOQUEADO_BUDGET
  BLOQUEADO_RATE_LIMIT
}

// Especialista da AI Platform que gerou o uso — permite analisar custo por
// especialista (seção 25 da fonte de verdade do Treinador) sem que o budget
// mensal deixe de ser agregado pra empresa inteira (calcularGastoMensalUSD
// nunca filtra por specialist).
enum EspecialistaIA {
  COACH
  TRAINER
  SIMULATOR
  // Teste de conexão do Admin (seção 30, Fatia 7.5B) — categoria própria
  // desde a Fatia 7.5D pra não misturar mais com o uso real do Conselheiro
  // (limitação documentada na Fatia 7.5B, corrigida aqui por ser barata).
  ADMIN_AI_TEST
  // Training Intelligence Platform (Fatia 7.5D) — cada agente lógico é seu
  // próprio specialist pra permitir atribuição de custo por etapa do
  // pipeline (seção 43), mesmo todos passando pelo AI Gateway único.
  RESEARCH_AGENT
  CURATOR_AGENT
  INSTRUCTIONAL_DESIGNER
  QUIZ_AGENT
  SIMULATION_DESIGNER
  GOVERNANCE_AGENT
  CONTENT_UPDATE_AGENT
  SELLER_TRAINING_AGENT
  MANAGER_TRAINING_AGENT
}

// Ledger auditável de cada chamada ao provider de IA — nunca um contador
// mutável. Gasto mensal é sempre SUM(estimatedCostUSD) deste mês, nunca um
// campo "currentSpend" editado (mesmo princípio já usado no ledger de moeda).
// Compartilhado por todos os especialistas — nunca duplicar esta tabela.
model AIUsage {
  id               String         @id @default(uuid())
  empresaId        String
  vendedorId       String
  specialist       EspecialistaIA @default(COACH)
  conversationId   String?
  messageId        String?
  provider         String
  model            String
  inputTokens      Int            @default(0)
  outputTokens     Int            @default(0)
  estimatedCostUSD Decimal        @db.Decimal(10, 6)
  latencyMs        Int            @default(0)
  status           StatusUsoIA
  createdAt        DateTime       @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@index([empresaId, createdAt])
  @@index([vendedorId, createdAt])
  @@index([specialist, createdAt])
  @@map("ai_usage")
}

model AIBudgetConfig {
  id                         String   @id @default(uuid())
  empresaId                  String   @unique
  monthlyLimitUSD            Decimal  @db.Decimal(10, 2)
  // Aplicado de forma INDEPENDENTE por especialista (Coach conta CoachMessage,
  // Treinador conta TrainerMessage, Simulator conta SimulationMessage —
  // decisão explícita da Fatia 5, não um descuido: achado de security
  // review, confiança 4/10, considerado aceito porque o teto de custo real é
  // monthlyLimitUSD, que É agregado entre todos os especialistas em
  // ai-platform/budget.service.ts). Ou seja, um vendedor pode enviar até
  // este número de mensagens em CADA especialista por dia, não um total
  // compartilhado entre eles.
  dailyMessageLimitPerSeller Int      @default(20)
  updatedAt                  DateTime @updatedAt
  updatedBy                  String

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("ai_budget_config")
}

// ============================================================================
// FATIA 7.5B — Admin AI Control Plane (AI Gateway, providers, credenciais)
// ============================================================================

enum NomeProviderIA {
  MOCK
  ANTHROPIC
  OPENAI
  GEMINI
}

// Só MANUAL nesta fatia (seção 6/84) — AUTO_CHEAPEST/FALLBACK_CHAIN ficam
// registrados como evolução futura, não implementados.
enum ModoProviderIA {
  MANUAL
}

// Configuração de IA por empresa — 1 linha por empresa, UM ÚNICO campo
// `activeProvider` (não uma lista de providers cada um com isActive). Isso
// satisfaz "exatamente um provider ativo" por construção de schema (nunca 0,
// nunca 2 — não existe uma tabela de providers pra ficar fora de sincronia),
// eliminando toda a categoria de corrida "duas ativações concorrentes" sem
// precisar de lock/transação especial: é sempre um único UPDATE numa única
// linha (seção 29/51 da fonte de verdade). Ausência de linha pra uma empresa
// = comportamento legado (env AI_PROVIDER/ANTHROPIC_API_KEY/AI_MODEL,
// idêntico ao pré-Fatia-7.5B) — nunca quebra dev/test/CI sem configuração.
model CompanyAIConfiguration {
  id             String         @id @default(uuid())
  empresaId      String         @unique
  mode           ModoProviderIA @default(MANUAL)
  activeProvider NomeProviderIA @default(MOCK)
  // Null = usa o default do provider (env.AI_MODEL pra Anthropic, ou o
  // default hardcoded do provider) — nunca uma string arbitrária sem
  // validação (seção 44): o Admin só escolhe entre os modelos permitidos
  // por provider, checados em `src/ai-platform/modelos-permitidos.ts`.
  activeModel    String?
  enabled        Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  updatedBy      String

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@map("company_ai_configuration")
}

// Credencial de provider real, cifrada em repouso (AES-256-GCM, seção 23) —
// NUNCA em claro. `ivBase64`/`authTagBase64` são únicos por linha (nonce
// aleatório a cada escrita); `keyVersion` prepara rotação futura da chave
// mestre sem exigir migração de schema. Nenhuma rota de leitura devolve
// `ciphertextBase64` pro cliente — só um booleano "configurado" (seção 25).
model AIProviderCredential {
  id               String         @id @default(uuid())
  empresaId        String
  provider         NomeProviderIA
  ciphertextBase64 String         @db.Text
  ivBase64         String
  authTagBase64    String
  keyVersion       Int            @default(1)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  updatedBy        String

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, provider])
  @@map("ai_provider_credential")
}

// Estado operacional observado (seção 39) — nunca "UP" inventado a partir só
// da configuração; só atualizado depois de uma chamada REAL (sucesso ou
// falha) ao provider, seja de um especialista ou do botão "Testar conexão".
model AIProviderHealth {
  id            String         @id @default(uuid())
  empresaId     String
  provider      NomeProviderIA
  lastCallAt    DateTime?
  lastCallOk    Boolean?
  lastErrorType String?
  lastLatencyMs Int?
  updatedAt     DateTime       @updatedAt

  empresa Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, provider])
  @@map("ai_provider_health")
}

// ============================================================
// FATIA 5 — TREINADOR DE VENDAS IA + PLAYBOOK
// ============================================================

enum StatusPlaybook {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CategoriaPlaybook {
  PRINCIPIOS
  ABORDAGEM
  SONDAGEM
  DEMONSTRACAO
  ARGUMENTACAO
  OBJECOES
  FECHAMENTO
  VENDA_COMPLEMENTAR
  POS_VENDA
  CONDUTA
}

// OFICIAL = extraído de material comercial real da empresa (auditável até a
// fonte). DEMONSTRATIVO = infraestrutura mínima pra categorias sem material
// oficial ainda — nunca deve ser apresentado ao vendedor como "regra da
// empresa" (seção 10 da Fatia 5). O prompt do Treinador distingue os dois.
enum OrigemConteudoPlaybook {
  OFICIAL
  DEMONSTRATIVO
}

// Playbook da empresa (seções 8-11 da Fatia 5 / seção 30 da fonte de
// verdade). Tenant-scoped e versionado — só a versão PUBLISHED é usada pelo
// Treinador, nunca DRAFT/ARCHIVED. Invariante "no máximo 1 PUBLISHED por
// empresa" garantida por índice único parcial (mesma técnica da Fatia 4 pra
// CoachConversation.ABERTA — ver migração 20260829223048_fatia5_treinador_playbook).
// Publicar uma nova versão preserva as anteriores (ARCHIVED) — uma resposta
// já gerada referencia o Playbook pelo id (versão), então uma republicação
// futura nunca reescreve retroativamente qual versão foi usada numa resposta
// antiga (seção 9 da Fatia 5).
model Playbook {
  id           String         @id @default(uuid())
  empresaId    String
  nome         String
  versao       Int
  status       StatusPlaybook @default(DRAFT)
  publicadoEm  DateTime?
  publicadoPor String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  empresa            Empresa           @relation(fields: [empresaId], references: [id])
  secoes             PlaybookSection[]
  mensagensTreinador TrainerMessage[]

  @@unique([empresaId, versao])
  @@index([empresaId, status])
  @@map("playbook")
}

model PlaybookSection {
  id         String                 @id @default(uuid())
  playbookId String
  categoria  CategoriaPlaybook
  titulo     String
  conteudo   String                 @db.Text
  origem     OrigemConteudoPlaybook
  ordem      Int                    @default(0)
  ativo      Boolean                @default(true)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  playbook Playbook @relation(fields: [playbookId], references: [id])

  @@index([playbookId, categoria, ativo])
  @@map("playbook_section")
}

enum ModoTreinador {
  GERAL
  ABORDAGEM
  SONDAGEM
  DEMONSTRACAO
  OBJECAO
  FECHAMENTO
  VENDA_COMPLEMENTAR
  PA
  TICKET
  POS_VENDA
}

enum StatusConversaTreinador {
  ABERTA
  ENCERRADA
}

// Mesma arquitetura de CoachConversation (Fatia 4), deliberadamente não
// generalizada numa tabela única `AIConversation` — ver seção 22 da Fatia 5 e
// Decisão 18 (05-Decisoes-e-Tradeoffs.md): o benefício de generalizar agora
// não supera o risco de tocar as tabelas do Coach já em produção. Mesma
// invariante "no máximo 1 ABERTA por vendedor" via índice único parcial.
model TrainerConversation {
  id                 String                  @id @default(uuid())
  empresaId          String
  lojaId             String
  vendedorId         String
  status             StatusConversaTreinador @default(ABERTA)
  geracaoEmAndamento Boolean                 @default(false)
  startedAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  closedAt           DateTime?

  vendedor  Vendedor         @relation(fields: [vendedorId], references: [id])
  mensagens TrainerMessage[]

  @@index([empresaId, lojaId, vendedorId])
  @@map("trainer_conversation")
}

enum RoleMensagemTreinador {
  USER
  ASSISTANT
}

model TrainerMessage {
  id                String                @id @default(uuid())
  conversationId    String
  role              RoleMensagemTreinador
  content           String                @db.Text
  // Só preenchidos em mensagens USER — metadado da pergunta, não da resposta.
  mode              ModoTreinador?
  objection         String?
  // Qual versão do Playbook foi usada pra gerar a resposta (mensagens
  // ASSISTANT) — auditável mesmo que uma versão futura seja publicada depois.
  playbookVersionId String?
  clientMessageId   String?
  provider          String?
  model             String?
  inputTokens       Int?
  outputTokens      Int?
  estimatedCostUSD  Decimal?              @db.Decimal(10, 6)
  latencyMs         Int?
  createdAt         DateTime              @default(now())

  conversation    TrainerConversation @relation(fields: [conversationId], references: [id])
  playbookVersion Playbook?           @relation(fields: [playbookVersionId], references: [id])

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@map("trainer_message")
}

// ============================================================
// FATIA 6 — SIMULADOR DE ATENDIMENTO IA + ACADEMIA DE VENDAS
// ============================================================

enum DificuldadeSimulacao {
  EASY
  MEDIUM
  HARD
}

// Catálogo GLOBAL (não por empresa) — mesmo padrão de Badge: são situações
// genéricas de atendimento de varejo, não política de uma empresa específica
// (a política específica entra em tempo real via playbookCategorias, que
// aponta pro Playbook JÁ tenant-scoped do vendedor que está simulando).
model SimulationScenario {
  id                     String   @id @default(uuid())
  code                   String   @unique
  title                  String
  description            String   @db.Text
  category               String
  objective              String
  active                 Boolean  @default(true)
  // Categorias do Playbook relevantes pra este cenário (ex.: ["OBJECOES"]) —
  // usado pelo SimulationContextBuilder pra buscar só as seções pertinentes,
  // igual ao Treinador (nunca o playbook inteiro).
  playbookCategorias     Json     @default("[]")
  // Critérios da rubrica relevantes pra este cenário (subconjunto de
  // ABORDAGEM/SONDAGEM/ESCUTA/ARGUMENTACAO/USO_DO_PLAYBOOK/
  // TRATAMENTO_DE_OBJECOES/VENDA_COMPLEMENTAR/FECHAMENTO/CLAREZA/
  // EXPERIENCIA_DO_CLIENTE) — nem todo cenário avalia todos.
  criteriosAvaliacao     Json     @default("[]")
  // Persona determinística por dificuldade — o LLM interpreta, não inventa.
  // Estrutura por chave EASY/MEDIUM/HARD: { profile, initialNeed,
  // hiddenNeeds[], objections[], behavior, successCondition }.
  personasPorDificuldade Json
  maxTurnsPorDificuldade Json     @default("{\"EASY\":8,\"MEDIUM\":11,\"HARD\":15}")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  // Universidade (Fatia 7.5E, seção 21) — competências que este cenário mede;
  // gera CompetencyEvidence (sourceType SIMULATION) quando a avaliação
  // termina, usando o scoreFinal já calculado pelo backend.
  competencyIds          Json     @default("[]")

  sessoes SimulationSession[]

  @@map("simulation_scenario")
}

enum StatusSimulacao {
  CREATED
  ACTIVE
  COMPLETED
  EVALUATION_PENDING
  EVALUATED
  FAILED
}

// Invariante "no máximo 1 sessão CREATED/ACTIVE por vendedor" garantida por
// índice único parcial (migração desta fatia) — mesma lição das Fatias 4/5:
// sem isso, chamadas concorrentes de criação de sessão poderiam abrir várias
// sessões simultâneas, cada uma com seu próprio lock de geração, furando
// rate limit/budget via mensagens em paralelo em sessões diferentes.
model SimulationSession {
  id                 String               @id @default(uuid())
  empresaId          String
  lojaId             String
  vendedorId         String
  scenarioId         String
  difficulty         DificuldadeSimulacao
  // Snapshot da persona usada nesta sessão — se o cenário for editado depois
  // (futuro CMS), uma sessão antiga preserva o que foi realmente usado
  // (mesmo raciocínio do playbookVersionId no Treinador).
  personaSnapshot    Json
  maxTurns           Int
  status             StatusSimulacao      @default(CREATED)
  turnCount          Int                  @default(0)
  reasonEnded        String?
  geracaoEmAndamento Boolean              @default(false)
  startedAt          DateTime             @default(now())
  endedAt            DateTime?
  evaluatedAt        DateTime?
  updatedAt          DateTime             @updatedAt

  vendedor   Vendedor               @relation(fields: [vendedorId], references: [id])
  cenario    SimulationScenario     @relation(fields: [scenarioId], references: [id])
  mensagens  SimulationMessage[]
  avaliacoes SimulationEvaluation[]

  @@index([empresaId, lojaId, vendedorId])
  @@index([vendedorId, status])
  @@map("simulation_session")
}

enum RoleMensagemSimulacao {
  VENDEDOR
  CLIENTE
}

model SimulationMessage {
  id               String                @id @default(uuid())
  sessionId        String
  role             RoleMensagemSimulacao
  content          String                @db.Text
  clientMessageId  String?
  provider         String?
  model            String?
  inputTokens      Int?
  outputTokens     Int?
  estimatedCostUSD Decimal?              @db.Decimal(10, 6)
  latencyMs        Int?
  createdAt        DateTime              @default(now())

  sessao SimulationSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, clientMessageId])
  @@index([sessionId, createdAt])
  @@map("simulation_message")
}

// Uma avaliação por (sessionId, versao) — v1 sempre versao=1; o campo existe
// pra permitir reavaliação futura sem migration (seção "idempotência" da
// Fatia 6 já prevê `simulationId + evaluationVersion` como chave).
model SimulationEvaluation {
  id                  String   @id @default(uuid())
  sessionId           String
  versao              Int      @default(1)
  criteriosAvaliados  Json
  scores              Json
  scoreFinal          Int
  strengths           Json     @default("[]")
  improvements        Json     @default("[]")
  missedOpportunities Json     @default("[]")
  betterExample       String   @db.Text
  summary             String   @db.Text
  provider            String
  model               String
  inputTokens         Int      @default(0)
  outputTokens        Int      @default(0)
  estimatedCostUSD    Decimal  @db.Decimal(10, 6)
  latencyMs           Int      @default(0)
  createdAt           DateTime @default(now())

  sessao SimulationSession @relation(fields: [sessionId], references: [id])

  @@unique([sessionId, versao])
  @@map("simulation_evaluation")
}

// ---------- Academia de Vendas ----------

// ===== Fatia 7.5C — CMS de treinamento (lifecycle editorial) =====
// Reaproveita o MESMO raciocínio 3→5 estados já usado no Playbook
// (StatusPlaybook: DRAFT/PUBLISHED/ARCHIVED, Fatia 5) — só que mais rico
// aqui porque a fonte de verdade desta fatia pede etapas intermediárias
// explícitas (REVIEW_PENDING/APPROVED). Nesta fatia o Admin acumula os
// papéis de criador e revisor (seção 55) — nada impede o mesmo Admin de
// chamar submeter→aprovar→publicar em sequência, mas os 5 estados existem
// como transições distintas e auditadas, nunca puladas silenciosamente.
enum StatusConteudo {
  DRAFT
  REVIEW_PENDING
  APPROVED
  PUBLISHED
  ARCHIVED
}

// Distinto de OrigemConteudoPlaybook (que já existia e significa "grounded
// em material real da empresa" vs. "boa prática genérica") — este novo eixo
// é sobre PROVENIÊNCIA EDITORIAL (quem/o quê produziu o conteúdo), pedido
// explicitamente pela fonte de verdade desta fatia. AI_RESEARCHED/
// AI_GENERATED existem só como destino futuro da Fatia 7.5D — nenhuma rota
// desta fatia cria conteúdo com essas origens.
enum OrigemEditorial {
  OFFICIAL_COMPANY
  ADMIN_CURATED
  AI_RESEARCHED
  AI_GENERATED
}

enum PublicoConteudo {
  SELLER
  MANAGER
  BOTH
}

enum TipoConteudoAula {
  TEXT
  VIDEO
  MATERIAL
  MIXED
}

// BASICA/INTERMEDIARIA existem pra dar ao Admin um jeito de sinalizar peso
// da questão; SITUACIONAL é o tipo "aplicação prática" pedido na seção 28.
enum DificuldadeQuestao {
  BASICA
  INTERMEDIARIA
  SITUACIONAL
}

enum TipoQuiz {
  REGULAR
  DIAGNOSTIC
}

// Catálogo GLOBAL (mesmo raciocínio de SimulationScenario/Badge). Conteúdo
// específico da empresa nunca é duplicado aqui — a aula só referencia uma
// categoria do Playbook (playbookCategoria); o texto oficial da empresa
// continua vivendo só em PlaybookSection. Permanece global mesmo após a
// Fatia 7.5C (decisão: este produto roda como 1 empresa por deployment —
// ver Decisão 1 do vault — então tenant-scoping de conteúdo de treinamento
// seria especulativo sem necessidade real hoje; documentado no vault).
model AcademyTrack {
  id          String   @id @default(uuid())
  code        String   @unique
  title       String
  description String   @db.Text
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // CMS (Fatia 7.5C) — default PUBLISHED/SELLER/ADMIN_CURATED/versão 1
  // preserva 100% a visibilidade do catálogo seedado pré-existente (nenhuma
  // trilha some da Academia por causa desta migração).
  status          StatusConteudo  @default(PUBLISHED)
  audience        PublicoConteudo @default(SELLER)
  origemEditorial OrigemEditorial @default(ADMIN_CURATED)
  version         Int             @default(1)
  createdBy       String?
  approvedBy      String?
  publishedAt     DateTime?
  // Universidade (Fatia 7.5E) — vínculo opcional a uma Escola (seção 4);
  // scalar solto (sem @relation), mesmo padrão de `trainingJobId` da Fatia
  // 7.5D, pra não acoplar o modelo do CMS ao da Universidade. Trilha sem
  // escolaId continua funcionando normalmente (nunca obrigatório).
  escolaId        String?
  // Onboarding (seção 51) — trilha marcada aparece priorizada em "Para Você"
  // pro vendedor recém-ativado, nunca bloqueia login nem é atribuída à força.
  onboarding      Boolean         @default(false)
  // Content → Competency mapping (seção 19) — array de ids de Competency,
  // validados pelo service ao gravar (nunca um id solto sem checagem).
  competencyIds   Json            @default("[]")

  aulas AcademyLesson[]

  @@index([status, audience])
  @@index([escolaId])
  @@map("academy_track")
}

model AcademyLesson {
  id                String                 @id @default(uuid())
  trackId           String
  code              String                 @unique
  title             String
  description       String
  content           String                 @db.Text
  // OFICIAL = extraído de material real da empresa; DEMONSTRATIVO = boa
  // prática genérica, claramente não-oficial (mesmo enum e mesmo raciocínio
  // do Playbook — seção 10 da Fatia 5, reaplicada aqui).
  origem            OrigemConteudoPlaybook @default(DEMONSTRATIVO)
  estimatedMinutes  Int
  sortOrder         Int                    @default(0)
  active            Boolean                @default(true)
  playbookCategoria CategoriaPlaybook?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // CMS (Fatia 7.5C) — mesmos defaults não-destrutivos do AcademyTrack.
  // tipoConteudo/videoUrl/materialUrl são aditivos: aulas existentes
  // continuam TEXT com `content` normal, sem nenhum vídeo/material.
  status          StatusConteudo   @default(PUBLISHED)
  audience        PublicoConteudo  @default(SELLER)
  origemEditorial OrigemEditorial  @default(ADMIN_CURATED)
  version         Int              @default(1)
  createdBy       String?
  approvedBy      String?
  publishedAt     DateTime?
  tipoConteudo    TipoConteudoAula @default(TEXT)
  // Só URL de provider allowlisted (YouTube/Vimeo) — nunca embed/iframe
  // bruto (seção 7). Validado em src/academia/media-seguranca.ts.
  videoUrl        String?
  // Seção 8: sem storage de upload maduro nesta fatia, MATERIAL é
  // deliberadamente um link externo (não um arquivo hospedado) — decisão
  // registrada no vault, não um upload fingido.
  materialUrl     String?
  // Training Intelligence (Fatia 7.5D) — rastreia de qual job este rascunho
  // veio, quando origemEditorial é AI_RESEARCHED/AI_GENERATED. Sempre null
  // pra aulas criadas manualmente pelo Admin (imensa maioria).
  trainingJobId   String?
  // Content → Competency mapping (Fatia 7.5E, seção 19) — usado pra gerar
  // CompetencyEvidence quando o vendedor conclui a aula (seção 22: score
  // conservador, peso baixo — concluir nunca significa "dominar").
  competencyIds   Json             @default("[]")

  track     AcademyTrack      @relation(fields: [trackId], references: [id])
  quiz      AcademyQuiz?
  progresso AcademyProgress[]

  @@index([trackId, sortOrder])
  @@index([status, audience])
  @@index([trainingJobId])
  @@map("academy_lesson")
}

model AcademyQuiz {
  id                  String   @id @default(uuid())
  lessonId            String   @unique
  // 70% documentado como default v1 (sem regra anterior na fonte de
  // verdade) — configurável por quiz, não hardcoded no motor.
  passingScore        Int      @default(70)
  // Blueprint do "quiz dinâmico" (seção 30-32): null preserva o
  // comportamento legado (mostra TODAS as perguntas do quiz, como sempre
  // foi) — só quizzes novos que o Admin configurar explicitamente com um
  // banco maior que o quiz ganham seleção aleatória por tentativa.
  questionsPerAttempt Int?
  // Universidade (Fatia 7.5E, seção 53) — quiz DIAGNOSTIC gera evidence
  // sourceType DIAGNOSTIC_ASSESSMENT (baseline) em vez de QUIZ regular;
  // mesmo cálculo de score, só a proveniência da evidência muda.
  tipo                TipoQuiz @default(REGULAR)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  aula      AcademyLesson     @relation(fields: [lessonId], references: [id])
  perguntas AcademyQuestion[]

  @@map("academy_quiz")
}

model AcademyQuestion {
  id        String   @id @default(uuid())
  quizId    String
  question  String   @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  // Banco de questões (seção 27-29, Fatia 7.5C) — `active=false` some do
  // pool de seleção sem apagar histórico; `sourceContentId` amarra a questão
  // à sua fonte (ex.: id de um MandamentoOficial) pra nunca ficar
  // semanticamente órfã.
  active          Boolean            @default(true)
  difficulty      DificuldadeQuestao @default(BASICA)
  topic           String?
  version         Int                @default(1)
  createdBy       String?
  sourceContentId String?
  updatedAt       DateTime           @updatedAt
  // Training Intelligence (Fatia 7.5D) — mesma disciplina de origem da
  // Fatia 7.5C aplicada ao banco de questões: uma questão gerada por IA
  // nasce `active: false` (nunca no pool publicado) até o Admin revisar e
  // ativá-la explicitamente. `trainingJobId` rastreia o job de origem.
  origemEditorial OrigemEditorial    @default(ADMIN_CURATED)
  trainingJobId   String?
  // Universidade (Fatia 7.5E, seção 20) — usado pelo Spaced Repetition
  // (seção 41): errar esta questão agenda revisão pro(s) conceito(s)/
  // competência(s) ligados a ela, nunca pra competência inteira do quiz.
  competencyIds   Json               @default("[]")

  quiz   AcademyQuiz     @relation(fields: [quizId], references: [id])
  opcoes AcademyOption[]

  @@index([quizId, sortOrder])
  @@index([quizId, active])
  @@index([trainingJobId])
  @@map("academy_question")
}

model AcademyOption {
  id         String  @id @default(uuid())
  questionId String
  text       String
  // Nunca exposto ao frontend antes da resposta ser submetida — ver
  // src/academia/quiz.service.ts.
  correct    Boolean @default(false)
  sortOrder  Int     @default(0)

  pergunta AcademyQuestion @relation(fields: [questionId], references: [id])

  @@index([questionId, sortOrder])
  @@map("academy_option")
}

enum StatusProgressoAcademia {
  IN_PROGRESS
  COMPLETED
}

// Sem linha = NOT_STARTED (nunca materializado) — só cria linha quando o
// vendedor de fato inicia a aula. @@unique garante 1 progresso por
// (vendedor, aula), nunca duplicado mesmo sob reentrância.
model AcademyProgress {
  id                         String                  @id @default(uuid())
  empresaId                  String
  lojaId                     String
  vendedorId                 String
  lessonId                   String
  status                     StatusProgressoAcademia @default(IN_PROGRESS)
  startedAt                  DateTime                @default(now())
  completedAt                DateTime?
  quizScore                  Int?
  quizPassed                 Boolean?
  // Quiz dinâmico (seção 33): ids das perguntas mostradas na tentativa mais
  // recente — usado só pra evitar repetir exatamente o mesmo conjunto na
  // tentativa seguinte, nunca como histórico completo de tentativas.
  ultimaTentativaQuestoesIds Json?
  updatedAt                  DateTime                @updatedAt

  vendedor Vendedor      @relation(fields: [vendedorId], references: [id])
  aula     AcademyLesson @relation(fields: [lessonId], references: [id])

  @@unique([vendedorId, lessonId])
  @@map("academy_progress")
}

// 13 Mandamentos das Vendas Sapatinho de Luxo (Fatia 7.5C, seção 23) —
// estrutura sempre presente (13 linhas, numero 1-13), conteúdo real
// PENDENTE até o Admin cadastrar (nunca inventado por código ou por IA,
// seção 24). Global, como o resto do catálogo da Academia.
model MandamentoOficial {
  id                 String         @id @default(uuid())
  numero             Int            @unique
  titulo             String
  conteudoOficial    String?        @db.Text
  explicacaoOpcional String?        @db.Text
  exemploOpcional    String?        @db.Text
  versao             Int            @default(1)
  status             StatusConteudo @default(DRAFT)
  createdBy          String?
  approvedBy         String?
  publishedAt        DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("mandamento_oficial")
}

// ===== Fatia 7.5D — Training Intelligence Platform =====
// IA não é autoridade editorial (regra fundamental da fonte de verdade
// desta fatia): todo output de agente nasce rascunho/revisável, nunca
// publicado automaticamente. O pipeline reaproveita o CMS da Fatia 7.5C
// (AcademyTrack/Lesson/Question em DRAFT, `origemEditorial` já preparado
// desde a Fatia 7.5A) em vez de criar uma abstração "ContentDraft"
// paralela — só o que não tem onde morar (o job em si, suas fontes de
// pesquisa e os achados de governança, e o rascunho de cenário de
// simulação, que exigiria alterar o Simulador ativo pra ganhar lifecycle)
// vira modelo novo.

enum TipoJobTreinamento {
  PACOTE_TREINAMENTO
  ATUALIZACAO_CONTEUDO
}

enum StatusJobTreinamento {
  QUEUED
  RUNNING
  WAITING_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

enum ConfiabilidadeFonte {
  UNKNOWN
  LOW
  MEDIUM
  HIGH
}

enum StatusGovernanca {
  PASS
  REVIEW_REQUIRED
  BLOCKED
}

enum TipoAchadoGovernanca {
  OFFICIAL_CONFLICT
  UNSUPPORTED_CLAIM
  COPYRIGHT_RISK
  BRAND_TONE
  INAPPROPRIATE_ADVICE
  MISSING_SOURCE
  LOW_RELIABILITY_SOURCE
  MANDAMENTO_VIOLATION
  OTHER
}

enum StatusRevisaoConteudo {
  UP_TO_DATE
  REVIEW_RECOMMENDED
  UPDATE_DRAFT
}

// Execução central do Training Orchestrator (seção 4/5) — um job por
// solicitação do Admin. Transições sempre atômicas (updateMany
// condicional), nunca ler-então-escrever, mesmo padrão desde a Fatia 4.
model TrainingIntelligenceJob {
  id                   String                 @id @default(uuid())
  empresaId            String
  requestedBy          String
  type                 TipoJobTreinamento     @default(PACOTE_TREINAMENTO)
  topic                String
  objective            String?                @db.Text
  targetAudience       PublicoConteudo        @default(SELLER)
  status               StatusJobTreinamento   @default(QUEUED)
  currentStep          String?
  attemptCount         Int                    @default(0)
  // Chave de idempotência opcional fornecida pelo Admin (double-click/retry
  // do cliente nunca cria 2 jobs iguais) — única por empresa, não global.
  idempotencyKey       String?
  errorMessage         String?                @db.Text
  governanceStatus     StatusGovernanca?
  // Resultado da revisão humana (seção 29) — nunca decidido pela IA.
  reviewOutcome        String?
  reviewNotes          String?                @db.Text
  // Só usado quando type = ATUALIZACAO_CONTEUDO (Content Update Agent).
  targetLessonId       String?
  updateRecommendation StatusRevisaoConteudo?
  createdAt            DateTime               @default(now())
  startedAt            DateTime?
  completedAt          DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  updatedAt            DateTime               @updatedAt

  sources  TrainingSource[]
  findings TrainingGovernanceFinding[]
  cenarios TrainingScenarioDraft[]

  @@unique([empresaId, idempotencyKey])
  @@index([empresaId, status])
  @@index([empresaId, createdAt])
  @@index([empresaId, requestedBy, createdAt])
  @@map("training_intelligence_job")
}

// Proveniência (seção 13/15) — nunca cópia de bloco extenso de terceiro,
// só metadado + resumo/insight (seção 14, Copyright Guard).
model TrainingSource {
  id              String              @id @default(uuid())
  jobId           String
  type            String              @default("WEB")
  url             String
  title           String
  publisher       String?
  author          String?
  publishedAt     DateTime?
  discoveredAt    DateTime            @default(now())
  retrievedAt     DateTime?
  summary         String              @db.Text
  reliability     ConfiabilidadeFonte @default(UNKNOWN)
  rightsNotes     String?             @db.Text
  excludedByAdmin Boolean             @default(false)

  job TrainingIntelligenceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("training_source")
}

// Achados do Governance Agent (seção 28/64) — persistidos mesmo quando o
// job segue pra revisão humana, nunca só um retorno efêmero de API.
model TrainingGovernanceFinding {
  id        String               @id @default(uuid())
  jobId     String
  type      TipoAchadoGovernanca
  severity  StatusGovernanca
  message   String               @db.Text
  createdAt DateTime             @default(now())

  job TrainingIntelligenceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("training_governance_finding")
}

// Rascunho de cenário do Simulation Designer (seção 24/25) — modelo PRÓPRIO
// (não o SimulationScenario ativo): dar lifecycle DRAFT/PUBLISHED ao
// catálogo já em produção do Simulador exigiria tocar `src/simulador/`
// sem necessidade comprovada (seção 25 permite deixar "contrato pronto" em
// vez de reconstruir o Simulador). Publicar copia os campos aprovados pra
// um SimulationScenario real — nunca o contrário.
model TrainingScenarioDraft {
  id                  String         @id @default(uuid())
  jobId               String
  empresaId           String
  title               String
  context             String         @db.Text
  customerProfile     String         @db.Text
  sellerObjective     String         @db.Text
  objections          Json           @default("[]")
  difficulty          String         @default("MEDIUM")
  competencies        Json           @default("[]")
  evaluationCriteria  Json           @default("[]")
  status              StatusConteudo @default(DRAFT)
  approvedBy          String?
  publishedScenarioId String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  job TrainingIntelligenceJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([empresaId, status])
  @@map("training_scenario_draft")
}

// ===== Fatia 7 — Missões e Desafios =====
// Missão é uma ação individual, objetiva e verificável — nunca "venda mais"
// solto. Conclusão SEMPRE por evidência do sistema (ledger/AcademyProgress/
// SimulationSession/StreakVendedor já existentes) — nunca frontend, nunca
// LLM. Catálogo (MissionDefinition) é GLOBAL, mesmo raciocínio de
// SimulationScenario/AcademyTrack — a atribuição (MissionAssignment) é sempre
// por vendedor.
enum CategoriaMissao {
  PERFORMANCE
  LEARNING
  SIMULATION
  CONSISTENCY
}

enum CriterioMissao {
  DAILY_GOAL
  PA_IMPROVEMENT
  TICKET_IMPROVEMENT
  COMPLETE_LESSON
  PASS_QUIZ
  COMPLETE_SIMULATION
  STREAK_3
}

enum PeriodoMissao {
  DIA
  SEMANA
}

enum StatusMissao {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  EXPIRED
  CANCELLED
}

// Onde a ação recomendada leva — referência estruturada, nunca URL livre
// (seção 17 da Fatia 7: "não persistir URLs arbitrárias vindas de usuário").
enum TipoAcaoMissao {
  COACH
  TRAINER
  SIMULATOR
  ACADEMY
  PERFORMANCE
}

model MissionDefinition {
  id              String          @id @default(uuid())
  code            String          @unique
  title           String
  description     String
  category        CategoriaMissao
  criterionType   CriterioMissao
  criterionConfig Json            @default("{}")
  periodType      PeriodoMissao   @default(DIA)
  actionType      TipoAcaoMissao
  actionReference Json?
  active          Boolean         @default(true)
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  // Universidade (Fatia 7.5E, seção 25) — só gera CompetencyEvidence quando
  // explicitamente mapeada (nunca qualquer missão vira "evidência de
  // competência" por padrão); score conservador, peso baixo (mesma lógica
  // de TRAINING_COMPLETION, seção 22).
  competencyIds   Json            @default("[]")

  atribuicoes MissionAssignment[]

  @@map("mission_definition")
}

model MissionAssignment {
  id                  String       @id @default(uuid())
  missionDefinitionId String
  empresaId           String
  lojaId              String
  vendedorId          String
  status              StatusMissao @default(ASSIGNED)
  assignedAt          DateTime     @default(now())
  startsAt            DateTime
  expiresAt           DateTime
  completedAt         DateTime?
  progressoAtual      Decimal      @default(0) @db.Decimal(12, 4)
  progressoAlvo       Decimal      @default(0) @db.Decimal(12, 4)
  source              String       @default("SYSTEM") // sempre atribuída pelo sistema nesta fatia — nunca pelo vendedor
  sourceReference     String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  definicao MissionDefinition @relation(fields: [missionDefinitionId], references: [id])
  vendedor  Vendedor          @relation(fields: [vendedorId], references: [id])

  // Nunca 2 atribuições da MESMA missão na MESMA janela pro mesmo vendedor —
  // reprocessar a atribuição diária/semanal é sempre um upsert idempotente,
  // nunca duplica (mesmo raciocínio de idempotencyKey do ledger, aqui via
  // constraint única em vez de string).
  @@unique([vendedorId, missionDefinitionId, startsAt])
  @@index([vendedorId, status])
  @@map("mission_assignment")
}

model ChallengeDefinition {
  id              String        @id @default(uuid())
  code            String        @unique
  title           String
  description     String
  criterionType   String
  criterionConfig Json          @default("{}")
  periodType      PeriodoMissao @default(SEMANA)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  atribuicoes ChallengeAssignment[]

  @@map("challenge_definition")
}

model ChallengeAssignment {
  id                    String       @id @default(uuid())
  challengeDefinitionId String
  empresaId             String
  lojaId                String
  vendedorId            String
  status                StatusMissao @default(ASSIGNED)
  assignedAt            DateTime     @default(now())
  startsAt              DateTime
  expiresAt             DateTime
  completedAt           DateTime?
  progressoAtual        Decimal      @default(0) @db.Decimal(12, 4)
  progressoAlvo         Decimal      @default(0) @db.Decimal(12, 4)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  definicao ChallengeDefinition @relation(fields: [challengeDefinitionId], references: [id])
  vendedor  Vendedor            @relation(fields: [vendedorId], references: [id])

  @@unique([vendedorId, challengeDefinitionId, startsAt])
  @@index([vendedorId, status])
  @@map("challenge_assignment")
}

// ============================================================================
// FATIA 7.5A — Identidade, acessos, Admin Foundation e privacidade comercial
// ============================================================================

enum StatusTokenAtivacao {
  PENDING
  USED
  EXPIRED
  REVOKED
}

// Token de ativação de conta (seção 39/40) — gerado pelo Admin ao
// pré-autorizar um vendedor, consumido uma única vez no fluxo de ativação
// (POST /auth/ativacao). Nunca armazenado em claro: só o hash SHA-256 do
// valor aleatório entregue ao Admin (que precisa repassar ao vendedor por um
// canal próprio — este projeto não tem infraestrutura de e-mail/SMS ainda,
// ver limitação documentada na fonte de verdade).
model ActivationToken {
  id         String              @id @default(uuid())
  vendedorId String
  tokenHash  String              @unique
  status     StatusTokenAtivacao @default(PENDING)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime            @default(now())

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@index([vendedorId, status])
  @@map("activation_token")
}

enum ErpProvider {
  LINX
}

enum MetodoVinculoErp {
  CPF
  EXTERNAL_ID
  SELLER_CODE
  MANUAL
}

enum StatusVinculoErp {
  PENDING
  VERIFIED
  REJECTED
}

// Fundação do vínculo Vendedor <-> identidade no ERP externo (seção 8/9) —
// modelo criado nesta fatia, mas SEM nenhuma chamada real ao Linx (isso é a
// Fatia 10). Existe pra que a identidade interna (Vendedor.id, sempre a
// chave primária real) já tenha onde registrar "este vendedor corresponde a
// tal matrícula/código no ERP X" quando a integração real existir, sem
// precisar de uma migração de schema depois.
model ExternalIdentity {
  id                 String           @id @default(uuid())
  empresaId          String
  vendedorId         String
  provider           ErpProvider
  externalSellerId   String?
  externalEmployeeId String?
  externalStoreId    String?
  matchMethod        MetodoVinculoErp
  status             StatusVinculoErp @default(PENDING)
  verifiedAt         DateTime?
  metadata           Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  vendedor Vendedor @relation(fields: [vendedorId], references: [id])

  @@unique([vendedorId, provider])
  @@index([empresaId, provider])
  @@map("external_identity")
}

// Auditoria de ações administrativas críticas (seção 42) — append-only por
// design (nenhuma rota de update/delete é exposta). `metadata` guarda só
// contexto não sensível (nunca CPF em claro, nunca token/senha).
model AuditEvent {
  id        String   @id @default(uuid())
  empresaId String
  actorId   String?
  targetId  String?
  acao      String
  metadata  Json?
  createdAt DateTime @default(now())

  ator Vendedor? @relation("AuditEventAtor", fields: [actorId], references: [id])
  alvo Vendedor? @relation("AuditEventAlvo", fields: [targetId], references: [id])

  @@index([empresaId, createdAt])
  @@index([targetId])
  @@map("audit_event")
}

// ===== Fatia 7.5E — Universidade de Vendas e Liderança =====
// Catálogo global (sem empresaId), mesmo raciocínio de AcademyTrack/
// SimulationScenario/MissionDefinition/MandamentoOficial — reafirma a
// Decisão 1 do vault ("1 empresa por deployment"). Referências a
// Vendedor.id (subjectUserId/userId/authorId) são SEMPRE scalars soltos,
// sem `@relation` formal — mesmo padrão de `trainingJobId` (Fatia 7.5D):
// evita inflar o modelo Vendedor com mais um `@relation` por tabela nova de
// alto volume/append-only; a integridade é garantida pelo service, nunca
// pela FK do banco.

model EscolaUniversidade {
  id          String          @id @default(uuid())
  code        String          @unique
  name        String
  description String          @db.Text
  audience    PublicoConteudo @default(BOTH)
  sortOrder   Int             @default(0)
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("escola_universidade")
}

enum StatusCompetencia {
  ACTIVE
  ARCHIVED
}

// Taxonomia administrável (seção 5) — nunca hardcoded na lógica de negócio;
// os catálogos iniciais de vendedor/gerente (seções 6/7) são seed, não um
// universo fechado no código.
model Competency {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  description String            @db.Text
  audience    PublicoConteudo   @default(SELLER)
  category    String?
  status      StatusCompetencia @default(ACTIVE)
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  targets    CompetencyTarget[]
  evidences  CompetencyEvidence[]
  planos     DevelopmentPlan[]
  avaliacoes ManagerAssessment[]

  @@map("competency")
}

// Target por papel (seção 16) — default conservador documentado (70), nunca
// tratado como verdade de negócio absoluta; Admin ajusta por competência.
model CompetencyTarget {
  id           String   @id @default(uuid())
  competencyId String
  papel        Papel
  targetScore  Int      @default(70)
  version      Int      @default(1)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competencia Competency @relation(fields: [competencyId], references: [id])

  @@unique([competencyId, papel])
  @@map("competency_target")
}

enum TipoFonteEvidencia {
  QUIZ
  SIMULATION
  TRAINING_COMPLETION
  MISSION
  PERFORMANCE
  MANAGER_ASSESSMENT
  CERTIFICATION
  RECERTIFICATION
  DIAGNOSTIC_ASSESSMENT
}

// Evidência é IMUTÁVEL por convenção de serviço (seção 9) — nenhuma função
// de update é exposta; uma correção sempre nasce como uma NOVA linha, nunca
// sobrescreve uma existente. Score 0-100 (seção 10) — nunca confundir com o
// Score Geral 0-1000 da Gamificação (motor totalmente diferente).
model CompetencyEvidence {
  id                   String             @id @default(uuid())
  subjectUserId        String
  competencyId         String
  sourceType           TipoFonteEvidencia
  sourceId             String?
  normalizedScore      Int
  weightProfileVersion Int                @default(1)
  occurredAt           DateTime           @default(now())
  validUntil           DateTime?
  metadata             Json?
  createdAt            DateTime           @default(now())

  competencia Competency @relation(fields: [competencyId], references: [id])

  @@index([subjectUserId, competencyId])
  @@index([competencyId])
  @@map("competency_evidence")
}

enum StatusPDI {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model DevelopmentPlan {
  id            String    @id @default(uuid())
  subjectUserId String
  competencyId  String
  baselineScore Int?
  targetScore   Int
  status        StatusPDI @default(ACTIVE)
  createdBy     String
  startedAt     DateTime  @default(now())
  targetDate    DateTime?
  completedAt   DateTime?
  version       Int       @default(1)
  updatedAt     DateTime  @updatedAt

  competencia Competency            @relation(fields: [competencyId], references: [id])
  itens       DevelopmentPlanItem[]

  @@index([subjectUserId, status])
  @@map("development_plan")
}

enum TipoItemPDI {
  LESSON
  TRACK
  QUIZ
  SIMULATION
  MISSION
  PRACTICE
  MANAGER_ACTION
  REVIEW
}

enum StatusItemPDI {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model DevelopmentPlanItem {
  id          String        @id @default(uuid())
  planId      String
  tipo        TipoItemPDI
  sourceId    String?
  sortOrder   Int           @default(0)
  required    Boolean       @default(true)
  status      StatusItemPDI @default(PENDING)
  completedAt DateTime?
  createdAt   DateTime      @default(now())

  plano DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("development_plan_item")
}

// Nunca atualizada (seção 28) — uma correção é sempre uma nova avaliação
// (version incrementada), a anterior nunca é sobrescrita/apagada.
model ManagerAssessment {
  id            String   @id @default(uuid())
  subjectUserId String
  competencyId  String
  authorId      String
  rating        Int
  evidenceNote  String?  @db.Text
  version       Int      @default(1)
  createdAt     DateTime @default(now())

  competencia Competency @relation(fields: [competencyId], references: [id])

  @@index([subjectUserId, competencyId])
  @@map("manager_assessment")
}

enum StatusRevisao {
  PENDING
  DONE
  SKIPPED
}

// Spaced Repetition (seção 40-44) — hoje só sourceType 'QUESTION'
// (AcademyQuestion.id); algoritmo determinístico simples (seção 42),
// documentado em spaced-repetition.service.ts.
model ReviewSchedule {
  id            String        @id @default(uuid())
  userId        String
  competencyId  String?
  sourceType    String        @default("QUESTION")
  sourceId      String
  nextReviewAt  DateTime
  intervalStage Int           @default(0)
  status        StatusRevisao @default(PENDING)
  lastResult    Boolean?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, sourceType, sourceId])
  @@index([userId, status, nextReviewAt])
  @@map("review_schedule")
}

// Lifecycle reaproveita StatusConteudo (mesma disciplina do CMS, Fatia
// 7.5C) — certificação é conteúdo administrável como qualquer outro.
model CertificationDefinition {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  description    String          @db.Text
  audience       PublicoConteudo @default(SELLER)
  status         StatusConteudo  @default(DRAFT)
  version        Int             @default(1)
  validityMonths Int?
  createdBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  requisitos CertificationRequirement[]
  emissoes   UserCertification[]

  @@map("certification_definition")
}

enum TipoRequisitoCertificacao {
  TRACK
  LESSON
  QUIZ_MIN_SCORE
  SIMULATION
  COMPETENCY_TARGET
  MANDAMENTOS_COMPLETOS
}

model CertificationRequirement {
  id           String                    @id @default(uuid())
  definitionId String
  tipo         TipoRequisitoCertificacao
  refId        String?
  minScore     Int?
  createdAt    DateTime                  @default(now())

  definicao CertificationDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@map("certification_requirement")
}

enum StatusUserCertificacao {
  VALID
  EXPIRING
  EXPIRED
}

// Idempotência da emissão (seção 48): @@unique garante 1 emissão por
// (usuário, definição, versão) — 2 requests concorrentes nunca duplicam
// (create + catch P2002, mesmo padrão desde a Fatia 4). Recertificação
// (seção 49) é uma NOVA linha (nova definitionVersion), histórico nunca
// apagado.
model UserCertification {
  id                String                 @id @default(uuid())
  userId            String
  definitionId      String
  definitionVersion Int
  issuedAt          DateTime               @default(now())
  expiresAt         DateTime?
  status            StatusUserCertificacao @default(VALID)
  evidenceSnapshot  Json
  createdAt         DateTime               @default(now())

  definicao CertificationDefinition @relation(fields: [definitionId], references: [id])

  @@unique([userId, definitionId, definitionVersion])
  @@index([userId])
  @@map("user_certification")
}
