NODE_ENV=development
APP_NAME=app-vendedor-sapatinho
PORT=3000
LOG_LEVEL=info

JWT_SECRET=
JWT_ISSUER=app-vendedor-sapatinho

# Identidade/CPF (Fatia 7.5A) — segredo do hash determinístico de CPF (nunca
# reversível, ver src/identidade/cpf.ts). NUNCA usar o mesmo valor do
# JWT_SECRET nem commitar um valor real aqui.
CPF_HASH_SECRET=
ACTIVATION_TOKEN_TTL_HOURS=168

# Admin AI Control Plane (Fatia 7.5B) — chave mestre AES-256-GCM (32 bytes
# hex) pra criptografar credenciais de provider por empresa. Opcional: sem
# ela, MOCK continua funcional, só não dá pra salvar credencial real.
AI_SECRETS_ENCRYPTION_KEY=

DATABASE_URL=postgresql://vendedor_app:senha@localhost:5435/app_vendedor_sapatinho
REDIS_URL=redis://localhost:6380

# --- Integrações de venda (Fase 1) ---
# As integrações (Linx, simulador, arquivo controlado) são configuradas pelo
# Admin em Configurações → Integrações — não por variável. A credencial do ERP
# fica CIFRADA no banco com esta chave mestra (AES-256-GCM, 64 hex). A chave
# NUNCA vai para o banco nem para o Git. Obrigatória em produção.
#   gerar: openssl rand -hex 32
INTEGRATION_SECRETS_ENCRYPTION_KEY=
# Frequência do sync automático (cron, fuso do processo). Padrão: a cada 15 min.
ERP_SYNC_CRON=*/15 * * * *
# Só testes/E2E: pasta lida pelo adapter CONTROLADO. Proibida em produção.
# ERP_CONTROLADO_DIR=

# Módulos anteriores à Fase 1 (Conselheiro, Treinador, Universidade…).
# Piloto: false — a API nem monta essas rotas. Proibido true em produção.
MODULOS_LEGADOS_ATIVOS=false

# Coach IA (Fatia 4) — AI_PROVIDER=mock por padrão (dev/test/CI), sem custo e
# sem internet. Trocar pra "anthropic" exige ANTHROPIC_API_KEY real — NUNCA
# commitar uma chave real aqui, só o placeholder vazio.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_TIMEOUT_MS=15000
AI_MAX_OUTPUT_TOKENS=400
AI_MAX_INPUT_CHARS=4000
AI_CONVERSATION_WINDOW=16
AI_DAILY_MESSAGE_LIMIT_DEFAULT=20
AI_MONTHLY_BUDGET_USD_DEFAULT=20

# Rate limit HTTP (Fatia 5) — valores abaixo são os mesmos já usados em
# produção (não mude aqui). Se rodar a suíte E2E completa localmente e ela
# esbarrar em 429 (Playwright faz várias jornadas em segundos, sem a cadência
# de um humano), aumente só no seu .env local — nunca commitar um valor maior
# aqui nem em ambiente real.
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Produção (Fatia 9.7) ---
# Allowlist de origens do CORS, separada por vírgula. OBRIGATÓRIA quando
# NODE_ENV=production (o boot falha sem ela, em vez de subir com CORS aberto).
# Ex.: https://app.exemplo.com,https://admin.exemplo.com
CORS_ORIGINS=
# Nº de proxies confiáveis à frente da API. 0 = sem proxy (local).
# Em produção é OBRIGATÓRIO ≥ 1 (o boot da API falha com 0).
# Em produção: conte os saltos REAIS até a API (nginx do compose = 1; com um
# proxy/TLS adicional no host = 2). Errar pra menos joga todos os usuários no
# mesmo bucket de rate limit (10 logins/min para a empresa inteira); errar pra
# mais deixa o cliente forjar o IP. Valide com uma rota que ecoe `req.ip`.
# Nunca use `true` — a validação de env recusa, justamente por isso.
TRUST_PROXY_HOPS=0
